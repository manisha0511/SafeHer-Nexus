# ==============================================================================
# SafeHer Nexus Mobile App - Environment Configuration Template
# Copy this file to .env for local development or device testing.
#
# CRITICAL SECURITY WARNING:
# Never put private API keys, database passwords, or Twilio tokens in EXPO_PUBLIC_* variables.
# EXPO_PUBLIC_* variables are bundled in plain-text into client APK/AAB files.
# All sensitive credentials and third-party integrations belong on the Spring Boot backend only.
# ==============================================================================

# 1. Android Studio Emulator (Development):
# 10.0.2.2 routes directly to your host machine's port 8080 from within the Android emulator:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# 2. Physical Android Device on the same Local Wi-Fi network (Testing):
# Replace with your computer's local network IPv4 address (e.g. found via `ipconfig`):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080

# 3. Production Release (Cloud / VPS / Managed Server with HTTPS):
# Never use HTTP, localhost, or 10.0.2.2 for production builds:
# EXPO_PUBLIC_API_BASE_URL=https://api.safehernexus.com
