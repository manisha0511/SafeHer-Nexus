# ===================================================================
# SafeHer Nexus Backend - Environment Variables Template
# Copy to a local environment setup or IDE run configuration.
# NEVER commit real passwords, database credentials, or JWT secrets.
# ===================================================================

# HTTP / HTTPS Server Configuration
SERVER_PORT=8080
SSL_ENABLED=false
SSL_KEYSTORE_PATH=classpath:keystore.p12
SSL_KEYSTORE_PASSWORD=your_keystore_password_here
SSL_KEY_ALIAS=safehernexus

# MySQL 8 Database Configuration (Confirm a NEW database name before starting)
# Example URL once you confirm the new database name (e.g., safeher_nexus_db):
DB_URL=jdbc:mysql://localhost:3306/safeher_nexus_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_mysql_username_here
DB_PASSWORD=your_mysql_password_here

# Hibernate Schema Validation Mode (Safe default: validate; use update only on a newly confirmed empty DB)
DB_DDL_AUTO=validate

# JWT Signing Configuration (Must be at least 32 characters / 256 bits for HMAC-SHA256)
JWT_SECRET=replace_with_a_strong_random_256_bit_secret_key_for_local_dev_only
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of permitted origins, e.g. for web/admin portal)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:19006,http://10.0.2.2:8080

# Twilio SMS Emergency Notifications (Server-Side Only - Never expose in mobile app)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE_NUMBER=+15550001234
TWILIO_STATUS_CALLBACK_URL=

# AI Safety Assistant (Server-Side Only - Keep all keys on backend, never in mobile app)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# Smart Route Guidance (Configurable directions provider)
ROUTE_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
ROUTE_TIMEOUT_MS=5000
